# =================================================================
# HACKFIX AI — Backend Environment Configuration
# =================================================================

# Google Gemini API Key (optional for basic scanning; required for AI explanations & chat)
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini model identifier (e.g. gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true

# Database storage
DATABASE_URL=sqlite:///./hackfix.db

# CORS allowed frontend origin
FRONTEND_ORIGIN=http://localhost:3000

# Scanner safety controls
# Comma-separated list of allowed hostnames for local dev testing (e.g. localhost, 127.0.0.1)
# By default, private/loopback IPs are strictly blocked.
SCAN_ALLOWED_HOSTS=

# Scan execution constraints
MAX_CRAWL_PAGES=20
MAX_CRAWL_DEPTH=2
REQUEST_TIMEOUT_SECONDS=10.0
SCAN_TIMEOUT_SECONDS=120.0
MAX_CONCURRENT_SCANS=3

# OWASP ZAP Baseline integration (optional)
ZAP_ENABLED=false
ZAP_BASE_URL=http://localhost:8080
ZAP_API_KEY=

